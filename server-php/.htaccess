# Jay Chat (InfinityFree / Apache)
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# 保留 Authorization 头（部分 CGI/FPM 环境会丢弃）
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# /api/* 全部交给 api/index.php 处理
RewriteRule ^api/(.*)$ api/index.php?r=api/$1 [QSA,L]
</IfModule>

# 禁止访问数据库/配置
<FilesMatch "\.(sqlite|db|ini|log)$">
Require all denied
</FilesMatch>
